{
  "rules": {
    "rooms": {
      // Allow reading room list and individual rooms
      ".read": "auth != null",
      
      // Allow creating new rooms
      ".write": "auth != null",
      
      "$roomId": {
        // Allow updates to existing rooms
        ".write": "auth != null && (
          !data.exists() || 
          data.child('players').child('0').child('uid').val() === auth.uid || 
          data.child('players').child('1').child('uid').val() === auth.uid ||
          !data.child('players').child('1').exists()
        )",
        
        "players": {
          "$index": {
            // Basic player data validation
            "uid": { ".validate": "newData.isString()" },
            "displayName": { ".validate": "newData.isString()" },
            "playerNumber": { ".validate": "newData.isNumber()" },
            "ready": { ".validate": "newData.isBoolean()" }
          }
        },
        
        "currentTurn": {
          ".validate": "newData.isNumber()"
        },
        
        "status": {
          ".validate": "newData.isString()"
        },
        
        "board": {
          "$row": {
            "$col": {
              ".validate": "newData.isString() || newData.val() === null"
            }
          }
        },
        
        "lastMove": {
          "row": { ".validate": "newData.isNumber()" },
          "col": { ".validate": "newData.isNumber()" },
          "player": { ".validate": "newData.isNumber()" },
          "timestamp": { ".validate": "newData.isNumber()" }
        }
      }
    }
  }
} 